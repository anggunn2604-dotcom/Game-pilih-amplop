    <!-- Setup Game Modal (Multiplayer, Zong, Rounds Configuration) -->
    <div id="setup-modal" class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <h3 class="text-xl font-black text-amber-400 mb-1 flex items-center gap-2">
