                    <button type="button" onclick="setPlayerCount(1)" class="player-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-count="1">1</button>
                    <button type="button" onclick="setPlayerCount(2)" class="player-count-btn py-2 rounded-xl text-xs font-bold border border-amber-500 bg-amber-500/20 text-amber-300" data-count="2">2</button>
                    <button type="button" onclick="setPlayerCount(3)" class="player-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-count="3">3</button>
                    <button type="button" onclick="setPlayerCount(4)" class="player-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-count="4">4</button>
                    <button type="button" onclick="setPlayerCount(5)" class="player-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-count="5">5</button>
                    <button type="button" onclick="setPlayerCount(6)" class="player-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-count="6">6</button>
