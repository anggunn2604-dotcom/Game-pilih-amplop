                    <button type="button" onclick="setTotalRounds(2)" class="round-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-round="2">2 Ronde</button>
                    <button type="button" onclick="setTotalRounds(3)" class="round-count-btn py-2 rounded-xl text-xs font-bold border border-amber-500 bg-amber-500/20 text-amber-300" data-round="3">3 Ronde</button>
                    <button type="button" onclick="setTotalRounds(4)" class="round-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-round="4">4 Ronde</button>
                    <button type="button" onclick="setTotalRounds(5)" class="round-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-round="5">5 Ronde</button>
                </div>
            </div>

            <!-- Modal Action Buttons -->
            <div class="flex justify-end gap-3 pt-3 border-t border-slate-800">
                <button type="button" onclick="closeSetupModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-400 hover:text-white bg-slate-800">Batal</button>
                <button type="button" onclick="startNewMatch()" class="px-6 py-2.5 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-lg shadow-amber-500/20">Mulai Permainan 🚀</button>
            </div>
