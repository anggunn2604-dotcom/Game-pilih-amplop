                </div>
            </div>

            <!-- Number of ZONG Envelopes -->
            <div class="mb-5">
                <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                    2. Jumlah Amplop Zong (1 - 5 Zong):
                </label>
                <div class="grid grid-cols-5 gap-2">
                    <button type="button" onclick="setZongCount(1)" class="zong-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-zong="1">1 Zong</button>
                    <button type="button" onclick="setZongCount(2)" class="zong-count-btn py-2 rounded-xl text-xs font-bold border border-amber-500 bg-amber-500/20 text-amber-300" data-zong="2">2 Zong</button>
                    <button type="button" onclick="setZongCount(3)" class="zong-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-zong="3">3 Zong</button>
                    <button type="button" onclick="setZongCount(4)" class="zong-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-zong="4">4 Zong</button>
                    <button type="button" onclick="setZongCount(5)" class="zong-count-btn py-2 rounded-xl text-xs font-bold border border-slate-700 bg-slate-800 text-slate-300" data-zong="5">5 Zong</button>
                </div>
            </div>

            <!-- Number of Rounds -->
            <div class="mb-6">
                <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                    3. Jumlah Ronde (1 - 5 Ronde):
