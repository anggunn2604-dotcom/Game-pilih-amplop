    <!-- Final Match Winner Modal -->
    <div id="winner-modal" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border-2 border-amber-500/60 rounded-3xl max-w-md w-full p-6 text-center shadow-2xl relative animate-bounce-short">
            <div class="w-20 h-20 bg-amber-500/20 border border-amber-400 rounded-full flex items-center justify-center mx-auto mb-4 text-4xl text-amber-400">
                👑
            </div>
            <h2 class="text-2xl font-black gold-gradient-text mb-1">PERMAINAN SELESAI!</h2>
            <p class="text-xs text-slate-400 mb-4">Pemenang Utama Pertandingan Ini Adalah:</p>
            
            <div class="bg-slate-950 border border-amber-500/40 rounded-2xl p-4 mb-6">
                <p id="winner-name" class="text-2xl font-black text-amber-300 mb-1">Pemain 1</p>
                <p id="winner-score" class="text-sm font-bold text-emerald-400">Total: 150 Koin 🪙</p>
            </div>

            <button onclick="closeWinnerModal(); openSetupModal();" class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold shadow-lg shadow-amber-500/30 transition">
                Main Match Baru 🎉
            </button>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-950 py-3 text-center text-xs text-slate-500">
        <p>Game Pilih Amplop Multiplayer • Fitur Koin, Zong 1-5 & Musik Synthesizer</p>
    </footer>

    <script>
        /* Audio Synthesizer (SFX + Procedural BGM Music Loop via Web Audio API) */
        let audioCtx = null;
        let soundEnabled = true;
        let bgmEnabled = true;
        let bgmInterval = null;
        let bgmNoteIndex = 0;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        // Catchy Procedural BGM Melody Sequence
        const bgmNotes = [
            261.63, 329.63, 392.00, 523.25, // C4, E4, G4, C5
            293.66, 349.23, 440.00, 587.33, // D4, F4, A4, D5
            329.63, 392.00, 493.88, 659.25, // E4, G4, B4, E5
            349.23, 440.00, 523.25, 698.46  // F4, A4, C5, F5
        ];

        function playBGMStep() {
            if (!bgmEnabled || !audioCtx) return;
            const now = audioCtx.currentTime;
            const freq = bgmNotes[bgmNoteIndex % bgmNotes.length];
            
            // Bass line note
            const bassOsc = audioCtx.createOscillator();
            const bassGain = audioCtx.createGain();
            bassOsc.type = 'triangle';
            bassOsc.frequency.setValueAtTime(freq / 2, now);
            bassGain.gain.setValueAtTime(0.03, now);
            bassGain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
            bassOsc.connect(bassGain);
            bassGain.connect(audioCtx.destination);
            bassOsc.start(now);
            bassOsc.stop(now + 0.2);

            // Arpeggio Lead
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, now);
            gain.gain.setValueAtTime(0.04, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now);
            osc.stop(now + 0.18);

            bgmNoteIndex++;
        }

        function startBGM() {
            initAudio();
            if (bgmInterval) clearInterval(bgmInterval);
            bgmInterval = setInterval(playBGMStep, 200); // 150 BPM arpeggio
        }

        function stopBGM() {
            if (bgmInterval) {
                clearInterval(bgmInterval);
                bgmInterval = null;
            }
        }

        function toggleBGM() {
            bgmEnabled = !bgmEnabled;
            const icon = document.getElementById('bgm-icon');
            const text = document.getElementById('bgm-text');
            if (bgmEnabled) {
                icon.className = 'fa-solid fa-music text-amber-400';
                text.innerText = 'Lagu: ON';
                startBGM();
            } else {
                icon.className = 'fa-solid fa-music-slash text-slate-500';
                text.innerText = 'Lagu: OFF';
                stopBGM();
            }
        }

        function playSound(type) {
            if (!soundEnabled) return;
            initAudio();

            const now = audioCtx.currentTime;

            if (type === 'click') {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(450, now);
                osc.frequency.exponentialRampToValueAtTime(850, now + 0.08);
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.08);
            } 
            else if (type === 'win') {
                const notes = [523.25, 659.25, 783.99, 1046.50];
                notes.forEach((freq, i) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + (i * 0.08));
                    gain.gain.setValueAtTime(0.2, now + (i * 0.08));
                    gain.gain.exponentialRampToValueAtTime(0.001, now + (i * 0.08) + 0.2);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now + (i * 0.08));
                    osc.stop(now + (i * 0.08) + 0.2);
                });
            } 
            else if (type === 'jackpot') {
                const notes = [440, 554.37, 659.25, 880, 1108.73, 1318.51];
                notes.forEach((freq, i) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, now + (i * 0.07));
                    gain.gain.setValueAtTime(0.25, now + (i * 0.07));
                    gain.gain.exponentialRampToValueAtTime(0.001, now + (i * 0.07) + 0.35);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now + (i * 0.07));
                    osc.stop(now + (i * 0.07) + 0.35);
                });
            }
            else if (type === 'zonk') {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, now);
                osc.frequency.linearRampToValueAtTime(80, now + 0.4);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.4);
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('sound-icon');
            const text = document.getElementById('sound-text');
            if (soundEnabled) {
                icon.className = 'fa-solid fa-volume-high text-emerald-400';
                text.innerText = 'SFX: ON';
            } else {
                icon.className = 'fa-solid fa-volume-xmark text-slate-500';
                text.innerText = 'SFX: OFF';
            }
        }

        let numPlayers = 2;
        let numZong = 2;
        let totalRounds = 3;
        let currentRound = 1;
        let currentPlayerIndex = 0;
        
        let players = []; // [{ id, name, coins }]
        let currentDeck = [];
        let openedEnvelopesThisTurn = 0;
        let historyLogs = [];

        const MIN_COIN_ENTRY = 5;

        function setPlayerCount(count) {
            numPlayers = count;
            document.querySelectorAll('.player-count-btn').forEach(btn => {
                const isSelected = parseInt(btn.dataset.count) === count;
                btn.className = `player-count-btn py-2 rounded-xl text-xs font-bold border ${isSelected ? 'border-amber-500 bg-amber-500/20 text-amber-300' : 'border-slate-700 bg-slate-800 text-slate-300'}`;
            });
            renderPlayerNameInputs();
        }

        function renderPlayerNameInputs() {
            const container = document.getElementById('player-inputs-container');
            container.innerHTML = '';
            for (let i = 0; i < numPlayers; i++) {
                const input = document.createElement('input');
                input.type = 'text';
                input.value = `Pemain ${i + 1}`;
                input.id = `input-player-name-${i}`;
                input.className = 'w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-amber-500';
                container.appendChild(input);
            }
        }

        function setZongCount(count) {
            numZong = count;
            document.querySelectorAll('.zong-count-btn').forEach(btn => {
                const isSelected = parseInt(btn.dataset.zong) === count;
                btn.className = `zong-count-btn py-2 rounded-xl text-xs font-bold border ${isSelected ? 'border-amber-500 bg-amber-500/20 text-amber-300' : 'border-slate-700 bg-slate-800 text-slate-300'}`;
            });
        }

        function setTotalRounds(count) {
            totalRounds = count;
            document.querySelectorAll('.round-count-btn').forEach(btn => {
                const isSelected = parseInt(btn.dataset.round) === count;
                btn.className = `round-count-btn py-2 rounded-xl text-xs font-bold border ${isSelected ? 'border-amber-500 bg-amber-500/20 text-amber-300' : 'border-slate-700 bg-slate-800 text-slate-300'}`;
            });
        }

        function openSetupModal() {
            playSound('click');
            document.getElementById('setup-modal').classList.remove('hidden');
        }

        function closeSetupModal() {
            playSound('click');
            document.getElementById('setup-modal').classList.add('hidden');
        }

        function startNewMatch() {
            playSound('click');
            if (bgmEnabled && !bgmInterval) startBGM();

            players = [];
            for (let i = 0; i < numPlayers; i++) {
                const inputEl = document.getElementById(`input-player-name-${i}`);
                const name = inputEl && inputEl.value.trim() ? inputEl.value.trim() : `Pemain ${i + 1}`;
                players.push({
                    id: i,
                    name: name,
                    coins: 50 // Standard starting coins balance
                });
            }

            currentRound = 1;
            currentPlayerIndex = 0;
            historyLogs = [];
            
            closeSetupModal();
            initRoundBoard();
        }

        function generatePrizeDeck() {
            let deck = [];

            // Add Requested Zong Envelopes (1 to 5)
            for (let i = 0; i < numZong; i++) {
                deck.push({ label: "ZONG ❌", value: 0, type: "zonk" });
            }

            // Reward Envelopes (Minimum Reward 5 Coins up to 100 Coins Jackpot)
            const rewardsPool = [
                { label: "+5 Koin 🪙", value: 5, type: "win" },
                { label: "+10 Koin 🪙", value: 10, type: "win" },
                { label: "+15 Koin 💰", value: 15, type: "win" },
                { label: "+25 Koin 💰", value: 25, type: "win" },
                { label: "+50 Koin 🌟", value: 50, type: "jackpot" },
                { label: "+100 Koin 🎉", value: 100, type: "jackpot" }
            ];

            // Always ensure total envelopes is at least (numZong + 4) for a good grid
            const targetTotalEnvelopes = Math.max(numZong + 4, 8);
            const remainingToFill = targetTotalEnvelopes - numZong;

            for (let i = 0; i < remainingToFill; i++) {
                const randomReward = rewardsPool[i % rewardsPool.length];
                deck.push({ ...randomReward });
            }

            // Fisher-Yates Shuffle
            for (let i = deck.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [deck[i], deck[j]] = [deck[j], deck[i]];
            }

            return deck;
        }

        function initRoundBoard() {
            document.getElementById('stat-round-display').innerText = `${currentRound} / ${totalRounds}`;
            document.getElementById('stat-zong-display').innerText = `${numZong} Amplop`;
            document.getElementById('btn-reveal-all').disabled = true;

            currentDeck = generatePrizeDeck();
            renderScoreboard();
            updateTurnBanner();

            const gridContainer = document.getElementById('envelope-grid');
            gridContainer.innerHTML = '';

            currentDeck.forEach((prizeItem, index) => {
                const envEl = document.createElement('div');
                envEl.className = 'perspective-1000 cursor-pointer select-none group';
                envEl.onclick = () => pickEnvelope(index);

                envEl.innerHTML = `
                    <div id="env-card-${index}" class="envelope-card relative w-full h-40 sm:h-48 bg-gradient-to-br from-red-600 to-red-800 rounded-2xl shadow-xl border-2 border-amber-500/40 p-4 flex flex-col items-center justify-center text-center transition-all duration-300 group-hover:scale-105 group-hover:shadow-amber-500/20">
                        <div class="envelope-flap absolute top-0 left-0 right-0 h-14 bg-red-700 rounded-t-2xl border-b border-red-900/40 flex justify-center items-start pt-1">
                            <div class="w-6 h-6 rounded-full bg-amber-500/30 border border-amber-400/50 flex items-center justify-center text-amber-300 text-xs">
                                🧧
                            </div>
                        </div>

                        <div class="mt-3 z-10 flex flex-col items-center gap-1">
                            <div class="w-10 h-10 rounded-full bg-amber-500/20 border border-amber-400/50 flex items-center justify-center text-amber-300 text-xl group-hover:rotate-12 transition transform">
                                ✉️
                            </div>
                            <span class="text-xs font-bold tracking-wider text-amber-200">Amplop #${index + 1}</span>
                            <span class="text-[10px] bg-amber-500/30 text-amber-300 px-2 py-0.5 rounded-full font-bold">Bayar 5 Koin 🪙</span>
                        </div>

                        <div id="env-result-${index}" class="absolute inset-0 bg-slate-900 rounded-2xl border-2 border-amber-500 p-3 flex flex-col items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
                            <span class="text-[10px] font-semibold text-slate-400 mb-1">Isi Amplop:</span>
                            <span id="env-prize-text-${index}" class="text-sm sm:text-base font-black text-amber-400 leading-tight"></span>
                        </div>
                    </div>
                `;
                gridContainer.appendChild(envEl);
            });
        }

        function pickEnvelope(index) {
            const activePlayer = players[currentPlayerIndex];

            // Check if envelope already opened
            const resultEl = document.getElementById(`env-result-${index}`);
            if (resultEl.classList.contains('opacity-100')) return;

            // Check if player has minimum 5 coins
            if (activePlayer.coins < MIN_COIN_ENTRY) {
                document.getElementById('game-status').innerText = `⚠️ ${activePlayer.name} tidak memiliki cukup koin (Min 5 Koin)! Giliran dilewati.`;
                document.getElementById('game-status').className = "text-sm md:text-base text-red-400 font-bold";
                nextPlayerTurn();
                return;
            }

            playSound('click');

            // Deduct 5 Coins entry fee
            activePlayer.coins -= MIN_COIN_ENTRY;

            const prize = currentDeck[index];
            const cardEl = document.getElementById(`env-card-${index}`);
            const prizeTextEl = document.getElementById(`env-prize-text-${index}`);

            cardEl.classList.add('open');

            setTimeout(() => {
                resultEl.classList.remove('opacity-0');
                resultEl.classList.add('opacity-100');
                prizeTextEl.innerText = prize.label;

                const statusEl = document.getElementById('game-status');

                if (prize.type === 'zonk') {
                    playSound('zonk');
                    resultEl.classList.add('border-slate-600', 'bg-slate-950');
                    prizeTextEl.className = "text-sm sm:text-base font-black text-slate-400";
                    statusEl.innerText = `😭 ${activePlayer.name} kena ZONG! Koin taruhan 5 koin hangus.`;
                    statusEl.className = "text-sm md:text-base text-red-400 font-bold";
                } else if (prize.type === 'jackpot') {
                    playSound('jackpot');
                    triggerConfetti();
                    resultEl.classList.add('border-amber-400', 'bg-gradient-to-b', 'from-amber-950', 'to-slate-900');
                    prizeTextEl.className = "text-sm sm:text-base font-black gold-gradient-text animate-bounce-short";
                    
                    activePlayer.coins += prize.value;
                    statusEl.innerText = `🎉 JACKPOT! ${activePlayer.name} mendapatkan ${prize.label}!`;
                    statusEl.className = "text-sm md:text-base text-amber-300 font-black animate-pulse";
                } else {
                    playSound('win');
                    resultEl.classList.add('border-emerald-500', 'bg-gradient-to-b', 'from-emerald-950', 'to-slate-900');
                    prizeTextEl.className = "text-sm sm:text-base font-black text-emerald-400";
                    
                    activePlayer.coins += prize.value;
                    statusEl.innerText = `💰 Hore! ${activePlayer.name} mendapatkan ${prize.label}!`;
                    statusEl.className = "text-sm md:text-base text-emerald-400 font-bold";
                }

                renderScoreboard();
                addHistoryLog(activePlayer.name, prize.label, index + 1);
                document.getElementById('btn-reveal-all').disabled = false;

                // Move turn to next player after a short pause
                setTimeout(() => {
                    nextPlayerTurn();
                }, 1200);

            }, 250);
        }

        function nextPlayerTurn() {
            currentPlayerIndex = (currentPlayerIndex + 1) % players.length;
            updateTurnBanner();
            renderScoreboard();
        }

        function updateTurnBanner() {
            const activePlayer = players[currentPlayerIndex];
            const banner = document.getElementById('active-player-banner');
            banner.innerText = activePlayer ? activePlayer.name : 'Pemain 1';
        }

        function renderScoreboard() {
            const container = document.getElementById('players-scoreboard');
            container.innerHTML = '';

            players.forEach((player, idx) => {
                const isActive = idx === currentPlayerIndex;
                const card = document.createElement('div');
                card.className = `p-3 rounded-xl border transition-all duration-300 flex flex-col items-center justify-center ${
                    isActive 
                        ? 'bg-amber-500/20 border-amber-400 shadow-lg shadow-amber-500/20 scale-105' 
                        : 'bg-slate-950/60 border-slate-800 opacity-80'
                }`;

                card.innerHTML = `
                    <span class="text-xs font-bold text-slate-300 truncate w-full text-center mb-1">${player.name}</span>
                    <div class="flex items-center gap-1">
                        <i class="fa-solid fa-coins text-amber-400 text-xs"></i>
                        <span class="text-sm font-black text-amber-400">${player.coins}</span>
                    </div>
                    ${isActive ? '<span class="mt-1 text-[9px] uppercase font-extrabold text-amber-300 bg-amber-500/30 px-2 py-0.5 rounded-full">GILIRAN</span>' : ''}
                `;
                container.appendChild(card);
            });
        }

        function startNextRound() {
            playSound('click');
            if (currentRound < totalRounds) {
                currentRound++;
                initRoundBoard();
                document.getElementById('game-status').innerText = `✨ Ronde ${currentRound} Dimulai! Giliran ${players[currentPlayerIndex].name}. ✨`;
                document.getElementById('game-status').className = "text-sm md:text-base text-amber-300 font-medium";
            } else {
                finishMatch();
            }
        }

        function finishMatch() {
            // Determine winner with most coins
            let sortedPlayers = [...players].sort((a, b) => b.coins - a.coins);
            let winner = sortedPlayers[0];

            triggerConfetti();
            playSound('jackpot');

            document.getElementById('winner-name').innerText = winner.name;
            document.getElementById('winner-score').innerText = `Total Hasil: ${winner.coins} Koin 🪙`;
            document.getElementById('winner-modal').classList.remove('hidden');
        }

        function closeWinnerModal() {
            document.getElementById('winner-modal').classList.add('hidden');
        }

        function revealAllEnvelopes() {
            playSound('click');
            currentDeck.forEach((prize, idx) => {
                const resultEl = document.getElementById(`env-result-${idx}`);
                const prizeTextEl = document.getElementById(`env-prize-text-${idx}`);
                resultEl.classList.remove('opacity-0');
                resultEl.classList.add('opacity-100');
                prizeTextEl.innerText = prize.label;
            });
            document.getElementById('btn-reveal-all').disabled = true;
        }

        function addHistoryLog(playerName, prizeLabel, envelopeNum) {
            const timeStr = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            historyLogs.unshift({ player: playerName, prize: prizeLabel, num: envelopeNum, time: timeStr });
            if (historyLogs.length > 6) historyLogs.pop();

            const historyContainer = document.getElementById('history-list');
            historyContainer.innerHTML = historyLogs.map(item => `
                <div class="flex items-center justify-between bg-slate-800/50 px-3 py-1.5 rounded-lg border border-slate-800">
                    <span class="text-slate-400"><strong class="text-amber-300">${item.player}</strong> (#${item.num}) - ${item.time}</span>
                    <span class="font-bold ${item.prize.includes('ZONG') ? 'text-red-400' : 'text-emerald-400'}">${item.prize}</span>
                </div>
            `).join('');
        }

        function triggerConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
            }
        }

        window.onload = function() {
            setPlayerCount(2);
            setZongCount(2);
            setTotalRounds(3);
            startNewMatch();
        };
    </script>
</body>
